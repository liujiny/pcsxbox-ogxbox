# ---------------------------------------------------------------
# Build output produced by build_oldxdk/build.sh
# ---------------------------------------------------------------
**/build_oldxdk/obj/
**/build_oldxdk/logs/
**/build_oldxdk/prof/
**/build_oldxdk_prof/
**/build_prof/
**/psx___Win32_Debug/
**/logs/

# any per-core build output directory (build_oldxdk, build_oldxdk_15r, ...)
# -- tracked files inside those dirs (build.sh, parse_vcproj.py, remap_core.py)
#    stay tracked; .gitignore only hides new build products.
**/build_oldxdk*/

# top-level release packages (contain built XBEs, skins, disc images)
Projects/PlayStation 1 - PCSXBox/Release/

# ---------------------------------------------------------------
# Compiler / linker artefacts
# (the vendored link inputs *.obj / *.lib under Projects/common
#  are tracked on purpose -- do not broaden these patterns)
# ---------------------------------------------------------------
*.xbe
*.exe
*.map
*.pdb
*.ilk
*.i64

# ---------------------------------------------------------------
# Visual Studio scratch
# ---------------------------------------------------------------
*.ncb
*.opt
*.aps
*.plg
*.sbr
*.bsc
*.idb
*.suo
*.user

# ---------------------------------------------------------------
# Never publish disc images, ROMs or BIOS dumps
# ---------------------------------------------------------------
*.chd
*.iso
*.img
*.cue
*.bin

# ---------------------------------------------------------------
# Local experiment artefacts (edit backups, profiler dumps, scratch)
# ---------------------------------------------------------------
*.pre_*
pcint.txt
rec2.txt
*.o
*.SO
*.dll
*.so
*.mcr
*.res
*.asm.bak
