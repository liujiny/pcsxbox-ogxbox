<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.10"
	Name="pcsxbox_betacore"
	SccProjectName=""
	SccLocalPath="">
	<Platforms>
		<Platform
			Name="Xbox"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Release|Xbox"
			OutputDirectory=".\Release"
			IntermediateDirectory=".\Release"
			ConfigurationType="1"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			WholeProgramOptimization="TRUE">
			<Tool
				Name="VCCLCompilerTool"
				GlobalOptimizations="TRUE"
				InlineFunctionExpansion="1"
				EnableIntrinsicFunctions="TRUE"
				FavorSizeOrSpeed="1"
				OptimizeForProcessor="2"
				AdditionalIncludeDirectories="..\..\Common\include,..\common,src\1.6,..\common\mp3,src\gpu\src,src\gpu\src\fpse,..\common\samba,..\common\sdl"
				PreprocessorDefinitions="WIN32,_USE_XGMATH,_XBOX,NDEBUG,IS_LITTLE_ENDIAN,__WIN32__,__i386__,PCSX_VERSION=&quot;1.4&quot;,_SDL,BETACORE"
				StringPooling="TRUE"
				RuntimeLibrary="0"
				EnableFunctionLevelLinking="TRUE"
				UsePrecompiledHeader="0"
				PrecompiledHeaderFile=".\Release/pcsxbox_betacore.pch"
				AssemblerListingLocation=".\Release/"
				ObjectFile=".\Release/"
				ProgramDataBaseFileName=".\Release/"
				BrowseInformation="1"
				WarningLevel="3"
				SuppressStartupBanner="TRUE"
				CompileAs="0"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386 /FIXED:NO"
				AdditionalDependencies="xzlib2.lib xapilib.lib d3d8.lib d3dx8.lib xgraphics.lib dsound.lib dmusic.lib xboxkrnl.lib xonline.lib libsmb.lib xkbd.lib"
				OutputFile=".\Release/pcsxbox_betacore.exe"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="..\common"
				ProgramDatabaseFile=".\Release/pcsxbox_betacore.pdb"
				OptimizeReferences="2"/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="xbcp -r -y -d -t -f media\*.* $(RemoteDir)media"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="XboxDeploymentTool"/>
			<Tool
				Name="XboxImageTool"
				AdditionalOptions="/initflags:0x0 "
				StackSize="0x100000"
				SuppressStartupBanner="TRUE"
				TitleID="0x08302006"
				MediaTypes="0x80000007"
				TitleName="pcsxbox_1.6core"/>
		</Configuration>
		<Configuration
			Name="Debug|Xbox"
			OutputDirectory=".\Debug"
			IntermediateDirectory=".\Debug"
			ConfigurationType="1"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				OptimizeForProcessor="2"
				AdditionalIncludeDirectories="..\..\Common\include,..\common,src\1.6,..\common\mp3,src\gpu\src,src\gpu\src\fpse,..\common\samba,..\common\sdl"
				PreprocessorDefinitions="WIN32,_USE_XGMATH,_XBOX,_DEBUG,__WIN32__,__i386__,PCSX_VERSION=&quot;1.4&quot;,_SDL,BETACORE"
				RuntimeLibrary="1"
				UsePrecompiledHeader="2"
				PrecompiledHeaderFile=".\Debug/pcsxbox_betacore.pch"
				AssemblerListingLocation=".\Debug/"
				ObjectFile=".\Debug/"
				ProgramDataBaseFileName=".\Debug/"
				BrowseInformation="1"
				WarningLevel="3"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"
				CompileAs="0"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386 /FIXED:NO"
				AdditionalDependencies="xzlib2.lib xapilibd.lib d3d8d.lib d3dx8d.lib xgraphicsd.lib dsoundd.lib dmusicd.lib xboxkrnl.lib xzlib.lib xonlined.lib libsmbd.lib xkbdd.lib"
				OutputFile=".\Debug/pcsxbox_betacore.exe"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="..\common"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile=".\Debug/pcsxbox_betacore.pdb"/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="xbepatch $(OutDir)\pcsxbox_betacore.xbe
xbcp -r -y -d -t -f media\*.* $(RemoteDir)media
"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="XboxDeploymentTool"/>
			<Tool
				Name="XboxImageTool"
				AdditionalOptions="/initflags:0x0 "
				StackSize="0xf0000"
				IncludeDebugInfo="TRUE"
				SuppressStartupBanner="TRUE"
				TitleID="0x08302006"
				TitleName="pcsxbox_1.6core"/>
		</Configuration>
	</Configurations>
